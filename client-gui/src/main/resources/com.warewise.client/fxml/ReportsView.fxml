<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<ScrollPane fitToWidth="true"
            xmlns="http://javafx.com/javafx/17.0.12"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.warewise.client.controller.ReportsController">
    <content>
        <VBox spacing="16" styleClass="dashboard-view">
            <padding>
                <Insets bottom="20" left="20" right="20" top="20" />
            </padding>

            <HBox alignment="CENTER_LEFT" spacing="12">
                <Label styleClass="section-title" text="Reports &amp; Analytics" />
                <ComboBox fx:id="reportSelector" prefWidth="220" styleClass="combo-box" />
                <Button mnemonicParsing="false" onAction="#exportPdf" text="Export PDF" />
            </HBox>

            <GridPane hgap="12" vgap="12">
                <VBox GridPane.columnIndex="0" GridPane.rowIndex="0" alignment="CENTER" spacing="4" styleClass="kpi-card">
                    <Label styleClass="kpi-title" text="Total Orders" />
                    <Label fx:id="totalOrdersLabel" styleClass="kpi-value" text="0" />
                </VBox>
                <VBox GridPane.columnIndex="1" GridPane.rowIndex="0" alignment="CENTER" spacing="4" styleClass="kpi-card">
                    <Label styleClass="kpi-title" text="Fulfilled Orders" />
                    <Label fx:id="fulfilledOrdersLabel" styleClass="kpi-value" text="0" />
                </VBox>
                <VBox GridPane.columnIndex="2" GridPane.rowIndex="0" alignment="CENTER" spacing="4" styleClass="kpi-card">
                    <Label styleClass="kpi-title" text="Stock Units" />
                    <Label fx:id="stockUnitsLabel" styleClass="kpi-value" text="0" />
                </VBox>
                <VBox GridPane.columnIndex="0" GridPane.rowIndex="1" alignment="CENTER" spacing="4" styleClass="kpi-card">
                    <Label styleClass="kpi-title" text="Inventory Value" />
                    <Label fx:id="inventoryValueLabel" styleClass="kpi-value" text="0.00" />
                </VBox>
                <VBox GridPane.columnIndex="1" GridPane.rowIndex="1" alignment="CENTER" spacing="4" styleClass="kpi-card">
                    <Label styleClass="kpi-title" text="Low Stock Records" />
                    <Label fx:id="lowStockLabel" styleClass="kpi-value" text="0" />
                </VBox>
                <VBox GridPane.columnIndex="2" GridPane.rowIndex="1" alignment="CENTER" spacing="4" styleClass="kpi-card">
                    <Label styleClass="kpi-title" text="Sold Revenue" />
                    <Label fx:id="revenueLabel" styleClass="kpi-value" text="0.00" />
                </VBox>
            </GridPane>

            <HBox spacing="16">
                <StackPane fx:id="chartPane" minHeight="320" prefHeight="340" prefWidth="620" styleClass="chart-container" HBox.hgrow="ALWAYS" />
                <TableView fx:id="reportTable" prefHeight="340" prefWidth="360">
                    <columns>
                        <TableColumn fx:id="metricColumn" text="Metric" />
                        <TableColumn fx:id="valueColumn" text="Value" />
                    </columns>
                </TableView>
            </HBox>
        </VBox>
    </content>
</ScrollPane>
