<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.image.ImageView?>
<?import de.jensd.fx.glyphs.fontawesome.FontAwesomeIconView?>

<VBox xmlns="http://javafx.com/javafx/17.0.12"
      xmlns:fx="http://javafx.com/fxml"
      alignment="CENTER"
      spacing="15"
      styleClass="sidebar" >

    <!-- Centered Logo -->
    <ImageView fx:id="logoImage" fitWidth="150" preserveRatio="true" />

    <!-- My Dashboard -->
    <Button fx:id="btnDashboard" styleClass="menu-item"
            text="My Dashboard"
            userData="DashboardView.fxml"
            onAction="#handleMenuAction">
        <graphic>
            <FontAwesomeIconView glyphName="HOME" styleClass="icon"/>
        </graphic>
    </Button>

    <!-- My Orders -->
    <Button fx:id="btnOrders" styleClass="menu-item"
            text="My Orders"
            userData="OrdersView.fxml"
            onAction="#handleMenuAction">
        <graphic>
            <FontAwesomeIconView glyphName="SHOPPING_CART" styleClass="icon"/>
        </graphic>
    </Button>

    <!-- Inventory Lookup -->
    <Button fx:id="btnUpdateInventory" styleClass="menu-item"
            text="Inventory Lookup"
            userData="UpdateInventoryView.fxml"
            onAction="#handleMenuAction">
        <graphic>
            <FontAwesomeIconView glyphName="CUBE" styleClass="icon"/>
        </graphic>
    </Button>

    <!-- Receive Shipments -->
    <Button fx:id="btnReceiveShipments" styleClass="menu-item"
            text="Receive Shipment"
            userData="ReceiveShipmentsView.fxml"
            onAction="#handleMenuAction">
        <graphic>
            <FontAwesomeIconView glyphName="TRUCK" styleClass="icon"/>
        </graphic>
    </Button>

    <!-- Add Item -->
    <Button fx:id="btnAddItem" styleClass="menu-item"
            text="Add Item"
            userData="AddItemView.fxml"
            onAction="#handleMenuAction">
        <graphic>
            <FontAwesomeIconView glyphName="PLUS" styleClass="icon"/>
        </graphic>
    </Button>

    <!-- Adjust &amp; Damage -->
    <Button fx:id="btnAdjustDamage" styleClass="menu-item"
            text="Adjust &amp; Damage"
            userData="AdjustDamageView.fxml"
            onAction="#handleMenuAction">
        <graphic>
            <FontAwesomeIconView glyphName="WRENCH" styleClass="icon"/>
        </graphic>
    </Button>

    <!-- Alerts -->
    <Button fx:id="btnAlerts" styleClass="menu-item"
            text="Alerts"
            userData="AlertsView.fxml"
            onAction="#handleMenuAction">
        <graphic>
            <FontAwesomeIconView glyphName="BELL" styleClass="icon"/>
        </graphic>
    </Button>

    <!-- Settings -->
    <Button fx:id="btnSettings" styleClass="menu-item"
            text="Settings"
            userData="SettingsView.fxml"
            onAction="#handleMenuAction">
        <graphic>
            <FontAwesomeIconView glyphName="COG" styleClass="icon"/>
        </graphic>
    </Button>

    <!-- Spacer -->
    <Pane VBox.vgrow="ALWAYS"/>
</VBox>
