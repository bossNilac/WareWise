<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Spinner?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="16"
      styleClass="dashboard-view"
      xmlns="http://javafx.com/javafx/17.0.12"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.warewise.client.controller.AdjustDamageController">
    <padding>
        <Insets bottom="20" left="20" right="20" top="20"/>
    </padding>

    <VBox spacing="4">
        <Label styleClass="section-title" text="Adjust &amp; Damage"/>
        <Label text="Record damaged, missing, or corrected stock for assigned inventory."/>
    </VBox>

    <GridPane hgap="14" vgap="12">
        <Label text="Inventory" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
        <ComboBox fx:id="inventoryCombo" prefWidth="420" GridPane.columnIndex="1" GridPane.rowIndex="0"/>

        <Label text="Adjustment type" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
        <ComboBox fx:id="adjustmentTypeCombo" prefWidth="220" GridPane.columnIndex="1" GridPane.rowIndex="1"/>

        <Label text="Quantity" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
        <Spinner fx:id="quantitySpinner" editable="true" prefWidth="160" GridPane.columnIndex="1" GridPane.rowIndex="2"/>

        <Label text="Reason" GridPane.columnIndex="0" GridPane.rowIndex="3"/>
        <TextArea fx:id="reasonArea" prefHeight="90" prefWidth="420" styleClass="transparent-text-area" wrapText="true" GridPane.columnIndex="1" GridPane.rowIndex="3"/>
    </GridPane>

    <HBox spacing="10">
        <Button text="Apply Adjustment" onAction="#applyAdjustmentAction"/>
        <Button text="Refresh" onAction="#refreshAction"/>
    </HBox>
</VBox>
